{
  "folders": [
    {
      "name": "lapis",
      "path": "./",
      "folder_exclude_patterns": [
        ".git", ".github", ".claude"
      ],
      "file_exclude_patterns": [
        "*.bak", "*.sublime-workspace"
      ],
      "binary_file_patterns": ["dist/*"]
    }
  ],
  "settings": {
    "translate_tabs_to_spaces": true,
    "trim_automatic_white_space": true,
    "trim_trailing_white_space_on_save": true,
    "rulers": [80, 100],
    "highlight_line": true,
    "word_wrap": false,
    "highlight_modified_tabs": true,
    "find_selected_text": true,
    "default_line_ending": "unix"
  },
  "build_systems": [
    {
      "name": "lapis: build",
      "shell_cmd": "go build -o lapis ./cmd/lapis",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    },
    {
      "name": "lapis: build all",
      "shell_cmd": "go build ./...",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    },
    {
      "name": "lapis: test",
      "shell_cmd": "go test ./...",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    }
  ]
}
