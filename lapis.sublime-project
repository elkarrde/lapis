{
  "folders": [
    {
      "name": "Have Lapis",
      "path": "./",
      "folder_exclude_patterns": [
        "node_modules", ".github", ".git", ".vscode", ".idea",
        "__pycache__", "pydevd_attach_to_process", "venv", ".phpintel", ".claude"
      ],
      "file_exclude_patterns": [
        "npm-debug.log", ".keep", ".gitkeep", "all.min.css", "package-lock.json",
        "*.min.js", "*.bak", "*.svg", "*.woff*", "*.sublime-workspace", "resume.sh"
      ],
      "binary_file_patterns": []
    }
  ],
  "settings": {
    "translate_tabs_to_spaces": true,
    "trim_automatic_white_space": true,
    "trim_trailing_white_space_on_save": true,
    "rulers": [80, 100],
    "highlight_line": true,
    "word_wrap": false,
    "hightlight_modified_tabs": true,
    "find_selected_text": true,
    "default_line_ending": "unix"
  }
}